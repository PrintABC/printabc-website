diff --git a/wwwroot/js/catalogs.js b/wwwroot/js/catalogs.js
new file mode 100644
index 0000000..3b7ebdd
--- /dev/null
+++ b/wwwroot/js/catalogs.js
@@ -0,0 +1,205 @@
+// Калькулятор «Каталоги и журналы». Цену считает только сервер (ТЗ §3, §9.1).
+(function () {
+    const form = document.getElementById('calc-form');
+    if (!form) return;
+
+    const totalOutput = document.getElementById('calc-total');
+    const vatOutput = document.getElementById('calc-vat');
+    const unitOutput = document.getElementById('calc-unit');
+    const validBlock = document.getElementById('valid_prices');
+    const manualBlock = document.getElementById('invalid_prices');
+    const minNote = form.querySelector('[data-min-note]');
+    const priceBox = form.querySelector('.price-box');
+    const next = document.getElementById('calc-next');
+    const nextOff = document.getElementById('calc-next-off');
+    const pagesInput = document.getElementById('calc-pages');
+    const pagesHint = form.querySelector('[data-pages-hint]');
+    const coverOpts = document.getElementById('cat-cover-opts');
+    const errorAlerts = form.querySelectorAll('.alert--error');
+    const limits = JSON.parse(form.dataset.limits);
+
+    const checked = name => form.querySelector(`input[name="${name}"]:checked`);
+    // «1346.19 ₪», в иврите число не переворачивается благодаря LRM (ТЗ §4)
+    const money = v => '‎' + Number(v).toFixed(2) + ' ₪‎';
+
+    function hideAllErrors() {
+        errorAlerts.forEach(alert => alert.hidden = true);
+    }
+
+    function setSend(enabled) {
+        next.hidden = !enabled;
+        nextOff.hidden = enabled;
+    }
+
+    function setCta(text) {
+        next.querySelector('[data-cta]').textContent = text;
+        nextOff.textContent = text;
+    }
+
+    function clearPrices() {
+        totalOutput.textContent = '—';
+        vatOutput.textContent = '—';
+        unitOutput.textContent = '—';
+    }
+
+    // mode: 'prices' — блок с ценой (или «—»), 'manual' — «рассчитаем индивидуально»
+    function showBlock(mode) {
+        validBlock.hidden = mode !== 'prices';
+        manualBlock.hidden = mode !== 'manual';
+    }
+
+    function render(result) {
+        hideAllErrors();
+        const data = result && result.data;
+        const status = data && data.status;
+
+        if (status === 'ready') {
+            showBlock('prices');
+            totalOutput.textContent = money(data.priceIncVatIls);
+            vatOutput.textContent = money(data.vatIls);
+            unitOutput.textContent = money(data.unitPriceIncVatIls);
+            minNote.hidden = !data.minApplied;
+            setCta(form.dataset.ctaOrder);
+            next.href = result.wpmessage;
+            setSend(true);
+        }
+        else if (status === 'manual_quote') {
+            // ТЗ §3.2 п.13: без цены, кнопка «Запросить расчёт в WhatsApp» с параметрами
+            showBlock('manual');
+            minNote.hidden = true;
+            setCta(form.dataset.ctaAsk);
+            next.href = result.wpmessage;
+            setSend(true);
+        }
+        else {
+            // ошибка проверки, HTTP 500, не-JSON, нет сети — всё сюда
+            const code = data && data.errorCode;
+            const alert = (code && form.querySelector(`[data-error="${CSS.escape(code)}"]`))
+                || form.querySelector('[data-error="generic"]');
+            alert.hidden = false;
+            showBlock('prices');
+            clearPrices();
+            minNote.hidden = true;
+            setCta(form.dataset.ctaOrder);
+            setSend(false);
+        }
+    }
+
+    let controller;
+    let lastRequest = 0;
+
+    async function triggerCalculation() {
+        controller?.abort();
+        controller = new AbortController();
+        const myRequest = ++lastRequest;
+
+        // пока ждём ответ: цена приглушена, кнопка неактивна (ТЗ §4)
+        priceBox.classList.add('is-pending');
+        setSend(false);
+
+        let result = null;
+        try {
+            const response = await fetch('?handler=Calculate', {
+                method: 'POST',
+                headers: {
+                    'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
+                },
+                body: new FormData(form),
+                signal: controller.signal
+            });
+            // JSON читаем и при 400 (если сервер начнёт отдавать ошибки с HTTP 400, ТЗ §5)
+            const type = response.headers.get('content-type') || '';
+            if (type.includes('application/json'))
+                result = await response.json();
+        }
+        catch (error) {
+            if (error.name === 'AbortError') return; // уже идёт более новый запрос
+        }
+        if (myRequest !== lastRequest) return;       // старый ответ не перезаписывает новый
+        priceBox.classList.remove('is-pending');
+        render(result);
+    }
+
+    // ТЗ §2: шаг, min, max поля страниц по переплёту, бумаге и обложке
+    function applyPageLimits(fixValue) {
+        const binding = checked('Binding').value;
+        const lim = limits[binding];
+
+        // бумага, запрещённая для переплёта (max = 0), неактивна; если выбрана — переключаем на 250 г
+        form.querySelectorAll('input[name="InnerPaper"]').forEach(r => r.disabled = lim.max[r.value] === 0);
+        if (checked('InnerPaper') === null || checked('InnerPaper').disabled) {
+            form.querySelector('input[name="InnerPaper"][value="250"]').checked = true;
+        }
+
+        const paper = checked('InnerPaper').value;
+        const hasCover = checked('HasCover').value === 'true';
+        const min = hasCover ? lim.minCover : lim.minNoCover;
+        const max = lim.max[paper];
+        const step = lim.step;
+        pagesInput.min = min;
+        pagesInput.max = max;
+        pagesInput.step = step;
+
+        if (fixValue) {
+            const n = parseInt(pagesInput.value, 10);
+            if (!isNaN(n)) {
+                let v = Math.min(Math.max(n, min), max);
+                v = Math.floor(v / step) * step;
+                if (v < min) v = min;
+                if (v !== n) pagesInput.value = v;
+            }
+        }
+
+        const bindingText = binding === 'Staple' ? form.dataset.bindStaple : form.dataset.bindSpiral;
+        pagesHint.textContent = form.dataset.hint
+            .replace('{0}', bindingText).replace('{1}', paper)
+            .replace('{2}', min).replace('{3}', max).replace('{4}', step);
+    }
+
+    function updateUIElements() {
+        document.getElementById("format_summary").innerText = checked('Format').value;
+        document.getElementById("binding_summary").innerText = form.querySelector("input[name='Binding']:checked+span").textContent;
+        document.getElementById("inner_page_summary").innerText = pagesInput.value;
+        document.getElementById("inner_paper_summary").innerText = form.querySelector("input[name='InnerPaper']:checked+span").textContent;
+        document.getElementById("cover_paper_summary").innerText = form.querySelector("input[name='CoverPaper']:checked+span").textContent;
+        const coverprint = checked('CoverPrint').value;
+        document.getElementById("cover_print_summary").innerText = coverprint.slice(0, 1) + "+" + coverprint.slice(1);
+
+        if (checked('Lamination').value == "None") {
+            document.getElementById("lamination_section").hidden = true;
+        }
+        else {
+            document.getElementById("lamination_section").hidden = false;
+            document.getElementById("lamination_summary").innerText = form.querySelector("input[name='Lamination']:checked+span").textContent;
+        }
+
+        document.getElementById("quantity_summary").innerText = document.getElementById('calc-qty').value;
+
+        // без обложки блок скрыт и поля обложки не уходят на сервер (ТЗ §4)
+        const hasCover = checked('HasCover').value === 'true';
+        coverOpts.hidden = !hasCover;
+        coverOpts.querySelectorAll('input').forEach(i => i.disabled = !hasCover);
+    }
+
+    function debounce(func, wait) {
+        let timeout;
+        return function (...args) {
+            clearTimeout(timeout);
+            timeout = setTimeout(() => func.apply(this, args), wait);
+        };
+    }
+
+    const recalc = debounce(triggerCalculation, 300);
+    form.addEventListener('change', e => {
+        if (['Binding', 'InnerPaper', 'HasCover'].includes(e.target.name)) applyPageLimits(true);
+    });
+    form.addEventListener('input', () => { updateUIElements(); recalc(); });
+
+    setSend(false);
+    // и при первой загрузке, и при «Назад» (без проверки persisted, ТЗ §4)
+    window.addEventListener('pageshow', () => {
+        updateUIElements();
+        applyPageLimits(true);
+        triggerCalculation();
+    });
+})();
