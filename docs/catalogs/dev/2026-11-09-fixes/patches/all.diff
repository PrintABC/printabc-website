@@ -0,0 +1,58 @@
+using static PrintABC.Services.CatalogCalculatorService;
+
+namespace PrintABC.Services
+{
+    // Секция "Catalogs" в appsettings.json (ТЗ §3.1). Имена свойств = ключи из ТЗ.
+    public class CatalogSettings
+    {
+        public Dictionary<int, CatalogPaperSettings> Papers { get; set; } = new();          // ключ = граммы
+        public Dictionary<CatalogSize, CatalogFormatSettings> Formats { get; set; } = new(); // ключ = A4/A5/A6
+        public List<CatalogSpiralSettings> Spirals { get; set; } = new();
+        public decimal ClickColorIls { get; set; }
+        public decimal LaminationUsdPerM2 { get; set; }
+        public decimal UsdRateIls { get; set; }
+        public decimal SheetAreaM2 { get; set; }
+        public decimal StaplesPerCopyIls { get; set; }
+        public int PunchSec { get; set; }
+        public int SpiralCloseSec { get; set; }
+        public decimal LaborRateIlsPerHour { get; set; }
+        public decimal WasteRate { get; set; }
+        public decimal MarkupThresholdIls { get; set; }
+        public decimal MarkupLow { get; set; }
+        public decimal MarkupHigh { get; set; }
+        public decimal MinOrderIls { get; set; }
+        public decimal MaxAutoPriceIls { get; set; }
+        public int MaxQuantity { get; set; }
+        public decimal VatRate { get; set; }
+
+        // Проверка при старте: для каждой бумаги и формата из списка продукта есть строка в конфиге
+        public bool IsComplete() =>
+            GetInnerPaperSizes().Concat(GetCoverPaperSizes()).All(Papers.ContainsKey)
+            && Enum.GetValues<CatalogSize>().All(Formats.ContainsKey)
+            && Spirals.Count > 0 && MaxQuantity > 0;
+    }
+
+    public class CatalogPaperSettings
+    {
+        public decimal SheetPriceIls { get; set; }
+        public decimal ThicknessMm { get; set; }
+        public int SheetsPerPunch { get; set; }
+        public int StapleMaxPages { get; set; }   // 0 = нельзя
+        public int SpiralMaxPages { get; set; }   // 0 = нельзя
+    }
+
+    public class CatalogFormatSettings
+    {
+        public int PagesPerSheet { get; set; }
+        public int CoversPerSheet { get; set; }
+        public decimal SpiralLengthFactor { get; set; }
+    }
+
+    public class CatalogSpiralSettings
+    {
+        public string Name { get; set; } = "";
+        public decimal DiameterMm { get; set; }
+        public decimal MaxThicknessMm { get; set; }
+        public decimal PriceA4Ils { get; set; }
+    }
+}
