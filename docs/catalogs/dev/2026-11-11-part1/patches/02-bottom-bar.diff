+﻿@{
+    //ViewData["BottomBar"] is set by the page: "order" = price bar of a calculator page, nothing = default bar (link to stickers)
+    var barMode = ViewData["BottomBar"] as string;
+}
+<a class="wa-float" href="https://wa.me/@(PHONE_NUMBER)" aria-label="@L["write_us"]"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z" /><path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6" /></svg></a>
+@if (barMode == "order")
+{
+    @* calculator page (catalogs): "Total … Order →", the page script fills the price and the link *@
+    <div class="bottom-bar"><div class="bottom-bar__price"><span class="bottom-bar__label">@L["total"]</span><output class="bottom-bar__total" data-bar-total aria-live="polite">— ₪</output></div><a class="btn btn--primary" data-bar-ok href="https://wa.me/@(PHONE_NUMBER)" hidden>@L["order"] <span aria-hidden="true">@L["order_arrow"]</span></a><a class="btn btn--secondary" data-bar-fix href="#calc-form" hidden>@L["fix_params"]</a><a class="btn-icon btn-icon--round btn-icon--whatsapp" href="https://wa.me/@(PHONE_NUMBER)" aria-label="@L["write_us"]"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z" /><path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6" /></svg></a></div>
