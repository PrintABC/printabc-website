diff --git a/wwwroot/css/pages.css b/wwwroot/css/pages.css
index 5a464ab..5d43a6f 100644
--- a/wwwroot/css/pages.css
+++ b/wwwroot/css/pages.css
@@ -346,3 +346,11 @@
 }
 /* "For 250 g with staple the maximum is 12 p. — changed 32 → 12." under the page field */
 .cat-autofix { color: var(--c-accent-ink); font-weight: 600; }
+/* Paper of the block: one option per line with a short note under the name */
+.opt-list--stack { flex-direction: column; }
+.opt-list--stack .pill { flex-direction: column; align-items: flex-start; justify-content: center; gap: 2px; padding: 8px 16px; border-radius: var(--r-md); }
+.opt-list--stack .pill:has(input:checked) { padding: 7px 15px; }
+.pill__note { font-weight: 400; font-size: var(--fs-hint); line-height: 1.35; color: var(--c-muted); }
+/* a disabled option: only the name is crossed out, the note says why ("only for spiral") */
+.opt-list--stack .pill--disabled { text-decoration: none; }
+.opt-list--stack .pill--disabled > span { text-decoration: line-through; }
