+        //page limits from CatalogCalculatorService.GetPageLimitsTable(), the server checks them again
+        const pageLimitsTable = @Json.Serialize(GetPageLimitsTable());
+        const pagesInput = document.getElementById('calc-pages');
+        const pagesHint = document.getElementById('pages-hint');
+
+        function updatePageLimits() {
+            const binding = form.querySelector("input[name='Binding']:checked").value;
+            const hasCover = form.querySelector("input[name='HasCover']:checked").value == 'true';
+
+            //paper that is not allowed for this binding (300 g for staple) is disabled, 250 g is picked instead
+            form.querySelectorAll("input[name='InnerPaper']").forEach(radio => {
+                const allowed = pageLimitsTable.some(r => r.binding == binding && r.paper == radio.value);
+                radio.disabled = !allowed;
+                if (!allowed && radio.checked)
+                    form.querySelector("input[name='InnerPaper'][value='250']").checked = true;
+            });
+
+            const paper = form.querySelector("input[name='InnerPaper']:checked").value;
+            const limits = pageLimitsTable.find(r => r.binding == binding && r.paper == paper && r.hasCover == hasCover);
+            if (!limits)
+                return;
+
+            pagesInput.min = limits.min;
+            pagesInput.max = limits.max;
+            pagesInput.step = limits.step;
+            pagesHint.textContent = pagesHint.dataset.template
+                .replace('{0}', limits.step).replace('{1}', limits.min).replace('{2}', limits.max);
+
+            //move the value to the nearest allowed one: down to max, up to min, down to a multiple of the step
+            let pages = parseInt(pagesInput.value) || limits.min;
+            pages = Math.min(Math.max(pages, limits.min), limits.max);
+            pages = pages - pages % limits.step;
+            if (pages < limits.min)
+                pages = limits.min;
+            pagesInput.value = pages;
+
+            updateUIElements();
+        }
+
+        //only on change of binding, paper or cover: while the client types the page count we do not move the value
+        form.addEventListener('change', e => {
+            if (['Binding', 'InnerPaper', 'HasCover'].includes(e.target.name))
+                updatePageLimits();
+        });
