@page "/Pinkasim"
@using System.Globalization
@model PrintABC.Pages.PinkasimModel
@*
    Страница «Бухгалтерские книжки». Цена считается в браузере (ТЗ v1.1):
      - сервер рисует таблицу цен из PinkasimModel.Kinds (у каждой кнопки data-price);
      - wwwroot/js/pinkasim.js берёт цену выбранной кнопки, пишет итог, сводку «Ваш заказ»,
        собирает ссылку WhatsApp и обновляет нижнюю панель на телефоне.
    Классы, id и data-* — как в макете design/mockup/{he,ru}/pinkasim.html: на них завязаны CSS и JS.
*@
@{
    ViewData["Title"] = L["meta_title"];
    ViewData["MetaDescription"] = L["meta_description"];
    // Нижняя панель на телефоне: вместо «Рассчитать цену наклеек» показать «Итого … Заказать →».
    // Смотрите Pages/Shared/_BottomBar.cshtml.
    ViewData["BottomBar"] = "order";

    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    // LRM (U+200E) — невидимый символ «слева направо». В иврите им обрамляем «240 ₪»,
    // чтобы число и знак ₪ не перепутались местами внутри текста справа налево (ТЗ §5).
    // RLM (U+200F) — то же «справа налево», ставим после «A5» в сводке на иврите.
    // В русском оба не нужны — пустая строка.
    var lrm = isRtl ? "‎" : "";
    var rlm = isRtl ? "‏" : "";

    // Все тексты, которые нужны скрипту pinkasim.js. Они попадают в страницу как JSON
    // в <script type="application/json" id="page-strings"> (см. ниже), а main.js кладёт их
    // в window.PRINTABC.t. Так в JS нет ни одного слова на русском или иврите (CLAUDE.md §2.1),
    // и нет inline-скрипта (ТЗ §9.1): JSON-блок браузер не выполняет как код.
    // .Value — обычная строка без HTML-кодирования; Json.Serialize сам экранирует опасные символы.
    var strings = new Dictionary<string, string>
    {
        ["kind_a5"] = L["kind_a5"].Value,
        ["kind_six"] = L["kind_six"].Value,
        ["kind_msg_a5"] = L["wa_kind_a5"].Value,
        ["kind_msg_six"] = L["wa_kind_six"].Value,
        ["copies_3"] = "3 " + L["copies"].Value,
        ["copies_2"] = "2 " + L["copies"].Value,
        ["copies_msg_3"] = L["wa_copies_3"].Value,
        ["copies_msg_2"] = L["wa_copies_2"].Value,
        ["qty_line"] = L["qty_line"].Value,
        ["msg_hello"] = L["msg_hello"].Value,
        ["msg_kind"] = L["msg_kind"].Value,
        ["msg_copies"] = L["msg_copies"].Value,
        ["msg_qty"] = L["msg_qty"].Value,
        ["msg_price"] = L["msg_price"].Value,
        ["msg_start"] = L["msg_start"].Value,
        ["msg_file"] = L["msg_file"].Value,
        ["lrm"] = lrm,
        ["rlm"] = rlm,
    };

    // Что показать до запуска JS (и что увидит поисковик): выбор по умолчанию A5 · 3 листа · 4 книжки.
    var defaultRow = PrintABC.Pages.PinkasimModel.Kinds[0].Rows.First(r => r.Qty == PrintABC.Pages.PinkasimModel.DefaultQty);
    var defaultBooks = PrintABC.Pages.PinkasimModel.BooksText(L, PrintABC.Pages.PinkasimModel.DefaultQty);
    var defaultSummary = L["kind_a5"].Value + rlm + " · " + strings["copies_3"] + " · " + L.GetString("qty_line", defaultBooks).Value;
}

@* JSON с текстами для pinkasim.js. type="application/json" — это данные, не код. *@
<script type="application/json" id="page-strings">@Json.Serialize(strings)</script>

<div class="container page-head">
    <h1>@L["pinkasim_header"]</h1>
    <p>@L["pinkasim_description"]</p>
</div>

@*
    data-wa-url — адрес WhatsApp из общей константы WHATSAPP_URL (Utils/Helpers.cs).
    JS дописывает к нему закодированный текст сообщения.
*@
<div class="container product-layout" id="pk-calc" data-wa-url="@WHATSAPP_URL">
    <div class="product-layout__main product-layout__main--wide">
        @* width/height — настоящий размер файла: браузер заранее оставит место под фото и страница не «прыгнет» (CLS). *@
        <img class="pk-hero" src="~/img/receipt-books.jpg" alt="@L["pinkasim_img_alt"]" width="1600" height="1073" decoding="async">
        <fieldset class="opt-group pk-kinds">
            <legend>@L["pinkasim_type"]</legend>
            <div class="opt-list">
                <label class="pill pk-kind">
                    <input autocomplete="off" type="radio" name="kind" value="a5" checked>
                    <span><strong>@L["kind_a5"]</strong><small>@L["type_a5"]</small></span>
                </label>
                <label class="pill pk-kind">
                    <input autocomplete="off" type="radio" name="kind" value="six">
                    <span><strong>@L["tab_sixes"]</strong><small>@L["type_sixes"]</small></span>
                </label>
            </div>
        </fieldset>
        <section class="section__stack section__stack--tight" aria-labelledby="tbl-h">
            @* data-kind-name — сюда JS пишет название выбранного вида. *@
            <div class="section-head"><h2 id="tbl-h">@L["price_title"] · <span data-kind-name>@L["kind_a5"]</span></h2><p>@L["select_from_table"]</p></div>
            <div class="price-table-wrap">
                @*
                    Обе таблицы (A5 и шестёрки) рисуются одним циклом из PinkasimModel.Kinds.
                    Видна только таблица выбранного вида, вторая скрыта атрибутом hidden.
                *@
                @foreach (var kind in PrintABC.Pages.PinkasimModel.Kinds)
                {
                    var isDefaultKind = kind.Code == PrintABC.Pages.PinkasimModel.DefaultKind;
                    var kindTitle = kind.Code == "a5" ? L["kind_a5"].Value : L["tab_sixes"].Value;
                    <table class="price-table pk-table" data-kind="@kind.Code" hidden="@(!isDefaultKind)">
                        <caption class="visually-hidden">@L["price_title"] · @kindTitle — @L["select_from_table"]</caption>
                        <thead>
                            <tr>
                                <th scope="col">@L["col_qty"]</th>
                                <th scope="col">@L["3_copies"]</th>
                                <th scope="col">@L["2_copies"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in kind.Rows)
                            {
                                // «4 книжки» / «4 פנקסים» — уже склонено на сервере.
                                // Кладём в data-books, чтобы JS взял готовый текст для сводки и WhatsApp.
                                var books = PrintABC.Pages.PinkasimModel.BooksText(L, row.Qty);
                                var isDefaultRow = isDefaultKind && row.Qty == PrintABC.Pages.PinkasimModel.DefaultQty;
                                <tr data-qty="@row.Qty" data-books="@books" class="@(isDefaultRow ? "is-selected" : null)">
                                    <th scope="row">@row.Qty</th>
                                    @*
                                        Две кнопки в строке: 3 листа и 2 листа.
                                        aria-label — то, что прочитает скринридер: «4 книжки · 3 листа · 240 ₪».
                                        aria-pressed="true" — выбранная кнопка.
                                    *@
                                    @foreach (var (copies, price) in new[] { (3, row.Price3), (2, row.Price2) })
                                    {
                                        var pressed = isDefaultRow && copies == PrintABC.Pages.PinkasimModel.DefaultCopies;
                                        <td><button class="price-btn" type="button" data-copies="@copies" data-price="@price" aria-pressed="@(pressed ? "true" : "false")" aria-label="@books · @copies @L["copies"] · @price ₪">@price ₪</button></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            @* Строка ошибки (ТЗ §4). Показывается, только если выбранный вариант не нашёлся в таблице. *@
            <div class="alert alert--error" data-error role="alert" hidden><div class="alert__row"><span>@L["error_not_found"]</span></div></div>
        </section>
        <section class="info-card" aria-labelledby="incl-h">
            <h2 id="incl-h">@L["what_included"]</h2><ul class="check-list">
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["incl_1"]</span></li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["incl_2"]</span></li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["incl_3"]</span></li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["incl_4"] </span></li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["incl_5"]</span></li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["incl_6"]</span></li>
        </ul>
    </section>
    </div>
    <section class="product-layout__side product-layout__side--narrow panel panel--raised summary-panel is-sticky" aria-labelledby="sum-h">
        <h2 id="sum-h">@L["your_order"]</h2>
        <div class="price-box">
            @* data-summary — сюда JS пишет «A5 · 3 листа · 4 книжки по 50 комплектов». *@
            <p class="cat-summary" data-summary>@defaultSummary</p>
            <div class="price-box__row price-box__row--total"><span>@L["total"]</span><output class="price-box__total" id="pk-total" aria-live="polite">@(lrm + defaultRow.Price3 + " ₪" + lrm)</output></div>
            <p class="field__hint">@L["inc_vat"]</p>
            <div class="price-box__row"><span>@L["price_ready"]</span><span>@L["prep_time"]</span></div>
        </div>
        @* href сразу ведёт в WhatsApp (на случай, если JS не загрузился); JS заменит его ссылкой с готовым текстом. *@
        <a class="btn btn--whatsapp btn--lg" id="pk-next" href="https://wa.me/@(PHONE_NUMBER)" target="_blank" rel="noopener noreferrer"><svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z"></path><path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6"></path></svg><span>@L["next_load_file"]</span></a>
        <a class="calc__ask" href="https://wa.me/@(PHONE_NUMBER)"><svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z"></path><path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6"></path></svg>@L["question_write_us"]</a>
    </section>
</div>

<section class="section--surface">
    <div class="container info-cards">
        <div class="info-card">
            <h2>@L["file_requirements"]</h2>
            <ul class="check-list">
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["file_1"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["file_2"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["file_3"]</span></li>
            </ul>
        </div>
        <div class="info-card">
            <h2>@L["pickup_payment"]</h2>
            <ul class="check-list">
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["pickup"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["pay"]</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="after-h">
    <div class="container section__stack">
        <div class="section-head"><h2 id="after-h">@L["after_order"]</h2></div>
        <ol class="steps">
            <li class="step"><span class="step__num" aria-hidden="true">01</span><h3>@L["after_1"]</h3></li>
            <li class="step"><span class="step__num" aria-hidden="true">02</span><h3>@L["after_2"]</h3></li>
            <li class="step"><span class="step__num" aria-hidden="true">03</span><h3>@L["after_3"]</h3></li>
            <li class="step"><span class="step__num" aria-hidden="true">04</span><h3>@L["after_4"]</h3></li>
        </ol>
    </div>
</section>

@section Scripts {
    @*
        Весь JS страницы — в отдельном файле (ТЗ §9.1, без inline-скриптов).
        defer: файл выполнится после разбора страницы и ПОСЛЕ main.js (он тоже defer и подключён раньше
        в _Layout), поэтому window.PRINTABC.t с текстами уже будет готов.
        asp-append-version добавляет к адресу ?v=хэш файла, чтобы после правки браузер не взял старую копию из кэша.
    *@
    <script src="~/js/pinkasim.js" asp-append-version="true" defer></script>
}
