@page "/Catalogs"
@using System.Globalization
@using static PrintABC.Services.CatalogCalculatorService
@model CatalogsModel
@{
    ViewData["Title"] = L["meta_title"];
    ViewData["MetaDescription"] = L["meta_description"];

    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var dir = isRtl ? "rtl" : "ltr";
}

<div class="container page-head">
    <h1>@L["catalogs_header"]</h1>
    <p>@L["catalogs_description"]</p>
</div>

<div class="container product-layout">
    <div class="product-layout__main is-sticky">
        <div class="cat-preview">
            <div class="cat-preview__stage" role="img" id="cat-preview" aria-label="תצוגה של החוברת: A4, סיכות, 12 עמ׳">
                <span class="cat-preview__cmyk" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                <div class="cat-book" data-fmt="A4" data-binding="staple">
                    <span class="cat-book__page cat-book__page--2" aria-hidden="true">
                    </span>
                    <span class="cat-book__page cat-book__page--1" aria-hidden="true">
                    </span>
                    <div class="cat-book__cover" aria-hidden="true">
                        <div class="cat-book__top">
                            <span class="cat-book__mark">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </span>
                            <span class="cat-book__title">קטלוג</span>
                            <span class="cat-book__sub" data-cover-sub="">A4 · 16 עמ׳</span>
                        </div>
                        <div class="cat-book__band">
                            <span></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <span class="cat-book__gloss">
                        </span>
                    </div>
                    <span class="cat-book__staple cat-book__staple--top" aria-hidden="true">
                    </span>
                    <span class="cat-book__staple cat-book__staple--bottom" aria-hidden="true">
                    </span>
                    <span class="cat-book__spiral" aria-hidden="true">
                    </span>
                </div>
            </div>
            <div class="cat-preview__chips" data-chips="">
                <span>A4</span>
                <span>סיכות</span>
                <span>12 עמ׳ · 130 גרם</span>
                <span>כריכה 250 גרם</span>
            </div>
        </div>
    </div>
    <form class="product-layout__side panel panel--raised calc" id="calc-form" aria-labelledby="calc-title" autocomplete="off" novalidate="">
        @Html.AntiForgeryToken()
        <div class="calc__head">
            <h2 id="calc-title">@L["price_calculator"]</h2>
        </div>
        <fieldset class="opt-group" id="g-fmt">
            <legend>@L["size_label"]</legend>
            <div class="opt-list">
                @foreach (CatalogSize item in Enum.GetValues<CatalogSize>())
                {
                    <label class="pill">
                        <input type="radio" name="Format" value="@item" checked="@(Model.Format == item)">
                        <span>@item · <span class="@isRtl">@L[$"size_{item}"]</span> @L["unit_cm"]</span>
                    </label>
                }
            </div>
        </fieldset>
        <fieldset class="opt-group" id="g-bind">
            <legend>@L["binding_label"]</legend>
            <div class="opt-list">
                @foreach (CatalogBinding item in Enum.GetValues<CatalogBinding>())
                {
                    <label class="pill">
                        <input type="radio" name="Binding" value="@item" checked="@(Model.Binding == item)">
                        <span>@L[$"binding_{item.ToString().ToLower()}"]</span>
                    </label>
                }
            </div>
        </fieldset>
        <fieldset class="opt-group" id="g-paper" aria-describedby="g-paper-hint">
            <legend>@L["innerpaper_label"]</legend>
            <div class="opt-list">
                @foreach (int item in GetInnerPaperSizes())
                {
                    <label class="pill">
                        <input type="radio" name="InnerPaper" value="@item" checked="@(Model.InnerPaper == item)">
                        <span>@L[$"innerpaper_{item}"]</span>
                    </label>
                }
            </div>
            <p class="field__hint" id="g-paper-hint">@L["paper_hint"]</p>
        </fieldset>
        <div class="field">
            <label class="field__label" for="calc-pages">@L["inner_pages_label"]</label>
            <input class="field__input field__input--num" id="calc-pages" name="InnerPageCount" type="number" inputmode="numeric" min="4" max="36" step="4" value="12" aria-describedby="pages-hint" aria-invalid="false">
            <p class="field__hint" id="pages-hint" data-pages-hint="">?</p>
        </div>
        <fieldset class="opt-group" id="g-cover" aria-describedby="g-cover-hint">
            <legend>@L["separate_cover_label"]</legend>
            <div class="opt-list">
                <label class="pill">
                    <input type="radio" name="HasCover" value="true" checked="@(Model.HasCover == true)">
                    <span>@L["yes"]</span>
                </label>
                <label class="pill">
                    <input type="radio" name="HasCover" value="false" checked="@(Model.HasCover == false)">
                    <span>@L["no"]</span>
                </label>
            </div>
            <p class="field__hint" id="g-cover-hint">@L["has_cover_hint"]</p>
        </fieldset>
        <div class="cat-cover-opts" id="cat-cover-opts" data-cover-opts="">
            <fieldset class="opt-group" id="g-cpaper" aria-describedby="g-cpaper-hint">
                <legend>@L["cover_paper_label"]</legend>
                <div class="opt-list">
                    <label class="pill">
                        <input type="radio" name="CoverPaper" value="250" checked="@(Model.CoverPaper == 250)">
                        <span>@L["cover_paper_250"]</span>
                    </label>
                    <label class="pill">
                        <input type="radio" name="CoverPaper" value="300" checked="@(Model.CoverPaper == 300)">
                        <span>@L["cover_paper_300"]</span>
                    </label>
                </div>
                <p class="field__hint" id="g-cpaper-hint">@L["cover_paper_hint"]</p>
            </fieldset>
            <fieldset class="opt-group" id="g-cprint">
                <legend>@L["cover_print_label"]</legend>
                <div class="opt-list">
                    <label class="pill">
                        <input type="radio" name="CoverPrint" value="40">
                        <span>@L["cover_print_40"]</span>
                    </label>
                    <label class="pill">
                        <input type="radio" name="CoverPrint" value="44" checked="">
                        <span>@L["cover_print_44"]</span>
                    </label>
                </div>
            </fieldset>
            <fieldset class="opt-group" id="g-lam" aria-describedby="g-lam-hint">
                <legend>@L["lamination_label"]</legend>
                <div class="opt-list">
                    @foreach (LaminationType item in Enum.GetValues<LaminationType>())
                    {
                        <label class="pill">
                            <input type="radio" name="Lamination" value="@item" checked="@(Model.Lamination == item)">
                            <span>@L[$"lamination_{item.ToString().ToLower()}"]</span>
                        </label>
                    }
                </div>
                <p class="field__hint" id="g-lam-hint">@L["lamination_hint"]</p>
            </fieldset>
        </div>
        <div class="field">
            <label class="field__label" for="calc-qty">@L["quantity_label"]</label>
            <input class="field__input field__input--num" id="calc-qty" name="Quantity" type="number" inputmode="numeric" min="6" step="1" value="@Model.Quantity" aria-describedby="q-hint" aria-invalid="false">
            <p class="field__hint" id="q-hint">@L["quantity_hint"]</p>
        </div>
        <!--errors-->
        <div class="alert alert--error" data-error="pages_step" role="alert" hidden="">
            <div class="alert__row">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9">
                    </circle>
                    <path d="M12 11v6M12 7.5v.5">
                    </path>
                </svg>
                <span>@L["error_pages_step"]</span>
            </div>
            <a href="https://wa.me/972508494172">@L["special_description"]</a>
        </div>
        <div class="alert alert--error" data-error="pages_min" role="alert" hidden="">
            <div class="alert__row">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9">
                    </circle>
                    <path d="M12 11v6M12 7.5v.5">
                    </path>
                </svg>
                <span>@L["error_pages_min"]</span>
            </div>
            <a href="https://wa.me/972508494172">@L["special_description"]</a>
        </div>
        <div class="alert alert--error" data-error="pages_max" role="alert" hidden="">
            <div class="alert__row">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9">
                    </circle>
                    <path d="M12 11v6M12 7.5v.5">
                    </path>
                </svg>
                <span>@L["error_pages_max"]</span>
            </div>
            <a href="https://wa.me/972508494172">@L["special_description"]</a>
        </div>
        <div class="alert alert--error" data-error="qty_min" role="alert" hidden="">
            <div class="alert__row">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9">
                    </circle>
                    <path d="M12 11v6M12 7.5v.5">
                    </path>
                </svg>
                <span>@L["error_qty_min"]</span>
            </div>
            <a href="https://wa.me/972508494172">@L["special_description"]</a>
        </div>
        <div class="alert alert--error" data-error="too_thick" role="alert" hidden="">
            <div class="alert__row">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9">
                    </circle>
                    <path d="M12 11v6M12 7.5v.5">
                    </path>
                </svg>
                <span>@L["error_too_thick"]</span>
            </div>
            <a href="https://wa.me/972508494172">@L["special_description"]</a>
        </div>
        <!--errors-->
        <div class="price-box">
            <p class="cat-summary">
                <strong>@L["your_order"]</strong>
                <br>
                <span data-summary=""><span id="format_summary">@Model.Format</span> · <span id="binding_summary">@Model.Binding</span> · <span id="inner_page_summary">@Model.InnerPageCount</span> @L["page"] · <span id="inner_paper_summary">@Model.InnerPaper</span> · @L["cover"] <span id="cover_paper_summary">@Model.CoverPaper</span> <span id="cover_print_summary">@Model.CoverPrint</span><span id="lamination_section"> @L["lamination"] <span id="lamination_summary"></span></span> · <span id="quantity_summary">@Model.Quantity</span> יח׳</span>
            </p>
            <div id="valid_prices" data-priced="">
                <div class="price-box__row price-box__row--total">
                    <span>@L["total_inc_vat"]</span>
                    <output class="price-box__total" id="calc-total" aria-live="polite">‎1346.19 ₪‎</output>
                </div>
                <div class="price-box__row">
                    <span>@L["price_just_vat"]</span>
                    <output id="calc-vat">‎205.35 ₪‎</output>
                </div>
                <div class="price-box__row">
                    <span>@L["price_per_unit"]</span>
                    <output id="calc-unit">‎13.46 ₪‎</output>
                </div>
                <p class="field__hint" data-min-note="" hidden="">@L["order_minimum_hint"]</p>
            </div>
            <div id="invalid_prices" data-manual="" hidden="" aria-live="polite">
                <p class="price-box__total">נחשב לכם אישית</p>
                <p class="field__hint">שלחו לנו את הפרמטרים ב-WhatsApp — נחזור עם מחיר.</p>
            </div>
            <div class="price-box__row"><span>@L["price_ready"]</span><span>@L["prep_time"]</span></div>
        </div>
        <a class="btn btn--whatsapp btn--lg" id="calc-next" href="#">
            <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z">
                </path>
                <path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6">
                </path>
            </svg>
            <span data-cta="">@L["next_load_file"]</span>
        </a>
        <span class="btn btn--lg" id="calc-next-off" aria-disabled="true" hidden="">@L["next_load_file"]</span>
        <a class="calc__ask" href="https://wa.me/972508494172">
            <svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z">
                </path>
                <path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6">
                </path>
            </svg>@L["question_write_us"]
        </a>
    </form>
</div>

