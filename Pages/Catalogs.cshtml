        <div class="section-head"><h2 id="after-h">@L["after_order"]</h2></div>
        <ol class="steps">
            <li class="step"><span class="step__num" aria-hidden="true">01</span><h3>@L["pick_calculate"]</h3><p class="step__text">@L["pick_calculate_description"]</p></li>
            <li class="step"><span class="step__num" aria-hidden="true">02</span><h3>@L["send_file"]</h3><p class="step__text">@L["send_file_description"]</p></li>
            <li class="step"><span class="step__num" aria-hidden="true">03</span><h3>@L["approve_sample"]</h3><p class="step__text">@L["approve_sample_description"]</p></li>
            <li class="step"><span class="step__num" aria-hidden="true">04</span><h3>@L["collect_order"]</h3><p class="step__text">@L["collect_order_description"]</p></li>
        </ol>
    </div>
</section>

@section Scripts {
    <script>
        const form = document.getElementById('calc-form');
        const totalOutput = document.getElementById('calc-total');
        const vatOutput = document.getElementById('calc-vat');
        const unitOutput = document.getElementById('calc-unit');

        const errorAlerts = form.querySelectorAll('.alert--error');

        function hideAllErrors() {
            errorAlerts.forEach(alert => alert.hidden = true);
        }

        function toggleInvalidPrices(state) {
            if (state) {//invalid prices
                document.getElementById("invalid_prices").removeAttribute("hidden");
                document.getElementById("valid_prices").setAttribute("hidden", "hidden");
            }
            else {//valid prices
                document.getElementById("valid_prices").removeAttribute("hidden");
                document.getElementById("invalid_prices").setAttribute("hidden", "hidden");
            }
        }

        function setSend(enabled) {
            if (enabled) {
                document.getElementById('calc-next').hidden = false;
                document.getElementById('calc-next-off').hidden = true;
            } else {
                document.getElementById('calc-next').hidden = true;
                document.getElementById('calc-next-off').hidden = false;
            }
        }

        setSend(false);
        const recalc = debounce(triggerCalculation, 300);
        form.addEventListener('input', updateUIElements);
        form.addEventListener('input', recalc);

        let controller;

        async function triggerCalculation() {
            controller?.abort();
            controller = new AbortController();
            try {
                const response = await fetch('?handler=Calculate', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: new FormData(form),
                    signal: controller.signal
                });

                if (response.ok) {
                    hideAllErrors();
                    const result = await response.json();
                    const targetError = (result.data.errorCode) ? form.querySelector(`[data-error="${result.data.errorCode}"]`) : null;
                    if (result.data.status == "manual_quote") {
                        toggleInvalidPrices(true);
                    }
                    else {
                        if (targetError || result.data.errorCode == "generic") {
                            if (targetError)
                                targetError.hidden = false; //unhide the correct error message
                            toggleInvalidPrices(true);
                            //disable "next" button and clear price outputs
                            setSend(false);
                            totalOutput.textContent = '—';
                            vatOutput.textContent = '—';
                            unitOutput.textContent = '—';
                        }
                        else {
                            //valid results, no errors
                            toggleInvalidPrices(false);
                            document.getElementById('calc-next').href = result.wpmessage;
                            setSend(true);
                            totalOutput.textContent = result.data.priceIncVatIls + '₪';
                            vatOutput.textContent = result.data.vatIls;
                            unitOutput.textContent = result.data.unitPriceIncVatIls;
                        }
                    }
                }
            }
            catch (error) {
                setSend(false);
                totalOutput.textContent = '—';
                vatOutput.textContent = '—';
                unitOutput.textContent = '—';
            }
        }

        function updateUIElements() {
            document.getElementById("format_summary").innerText = document.querySelector("input[name='Format']:checked").value;
            document.getElementById("binding_summary").innerText = document.querySelector("input[name='Binding']:checked+span").textContent;
            document.getElementById("inner_page_summary").innerText = document.querySelector("input[name='InnerPageCount']").value;
            document.getElementById("inner_paper_summary").innerText = document.querySelector("input[name='InnerPaper']:checked+span").textContent;
            document.getElementById("cover_paper_summary").innerText = document.querySelector("input[name='CoverPaper']:checked+span").textContent;
            let coverprint = document.querySelector("input[name='CoverPrint']:checked").value
            document.getElementById("cover_print_summary").innerText = coverprint.slice(0, 1) + "+" + coverprint.slice(1);

            if (document.querySelector("input[name='Lamination']:checked").value == "None") {
                document.getElementById("lamination_section").setAttribute("hidden", true);
            }
            else {
                document.getElementById("lamination_section").removeAttribute("hidden");
                document.getElementById("lamination_summary").innerText = document.querySelector("input[name='Lamination']:checked+span").textContent;
            }

            document.getElementById("quantity_summary").innerText = document.querySelector("input[name='Quantity']").value;

            if (document.querySelector("input[name='HasCover']:checked").value != 'true') {
                document.getElementById("cat-cover-opts").setAttribute("hidden", true);
            }
            else
                document.getElementById("cat-cover-opts").removeAttribute("hidden");

        }


        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }
        triggerCalculation();
        updateUIElements();
        window.addEventListener('pageshow', e => {
            if (e.persisted) { triggerCalculation(); }
        });
    </script>
}