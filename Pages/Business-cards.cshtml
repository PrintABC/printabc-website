@page "/business-cards"
@model PrintABC.Pages.Business_cardsModel


<div class="container page-head">
    <h1>@L["business_cards_title"]</h1>
    <p>@L["business_cards_title_description"]</p>
</div>

<div class="container product-layout" id="cards-calc">
    <div class="product-layout__main product-layout__main--wide">
        <div class="gallery--pair"><img src="~/img/business-cards.jpg" alt="@L["business_cards_pile_alt"]" decoding="async"><img src="~/img/business-cards-lamination.jpg" alt="@L["business_cards_with_lamination_alt"]" decoding="async"></div>
        <section class="section__stack section__stack--tight" aria-labelledby="tbl-h">
            <div class="section-head"><h2 id="tbl-h">@L["pricelist"]</h2><p>@L["pricelist_choose_table"]</p></div>
            <div class="price-table-wrap">
                <table class="price-table" id="price-table">
                    <caption class="visually-hidden">@L["pricelist_choose_table_caption"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@L["thead_amount"]</th>
                            <th scope="col">@L["thead_one_side"]</th>
                            <th scope="col">@L["thead_two_sides"]</th>
                            <th scope="col">@L["thead_lamination"]</th>
                            <th scope="col">@L["thead_round_corners"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr data-qty="100" data-lam="30" data-round="50">
                            <th scope="row">100</th>
                            <td><button class="price-btn" type="button" data-sides="one" data-price="100" aria-pressed="false" aria-label="100 @L["amt_oneside_aria"] 100 ₪">100 ₪</button></td>
                            <td><button class="price-btn" type="button" data-sides="two" data-price="120" aria-pressed="false" aria-label="100 @L["amt_twoside_aria"] 120 ₪">120 ₪</button></td>
                            <td class="addon">+30 ₪</td>
                            <td class="addon">+50 ₪</td>
                        </tr>
                        <tr data-qty="200" data-lam="45" data-round="50">
                            <th scope="row">200</th>
                            <td><button class="price-btn" type="button" data-sides="one" data-price="155" aria-pressed="false" aria-label="200 @L["amt_oneside_aria"] 155 ₪">155 ₪</button></td>
                            <td><button class="price-btn" type="button" data-sides="two" data-price="180" aria-pressed="false" aria-label="200 @L["amt_twoside_aria"] 180 ₪">180 ₪</button></td>
                            <td class="addon">+45 ₪</td>
                            <td class="addon">+50 ₪</td>
                        </tr>
                        <tr data-qty="500" data-lam="60" data-round="60" class="is-selected">
                            <th scope="row">500</th>
                            <td><button class="price-btn" type="button" data-sides="one" data-price="190" aria-pressed="false" aria-label="500 @L["amt_oneside_aria"] 190 ₪">190 ₪</button></td>
                            <td><button class="price-btn" type="button" data-sides="two" data-price="230" aria-pressed="true" aria-label="500 @L["amt_twoside_aria"] 230 ₪">230 ₪</button></td>
                            <td class="addon">+60 ₪</td>
                            <td class="addon">+60 ₪</td>
                        </tr>
                        <tr data-qty="1,000" data-lam="70" data-round="70">
                            <th scope="row">1,000</th>
                            <td><button class="price-btn" type="button" data-sides="one" data-price="250" aria-pressed="false" aria-label="1,000 @L["amt_oneside_aria"] 250 ₪">250 ₪</button></td>
                            <td><button class="price-btn" type="button" data-sides="two" data-price="280" aria-pressed="false" aria-label="1,000 @L["amt_twoside_aria"] 280 ₪">280 ₪</button></td>
                            <td class="addon">+70 ₪</td>
                            <td class="addon">+70 ₪</td>
                        </tr>
                        <tr data-qty="2,000" data-lam="95" data-round="95">
                            <th scope="row">2,000</th>
                            <td><button class="price-btn" type="button" data-sides="one" data-price="410" aria-pressed="false" aria-label="2,000 @L["amt_oneside_aria"] 410 ₪">410 ₪</button></td>
                            <td><button class="price-btn" type="button" data-sides="two" data-price="500" aria-pressed="false" aria-label="2,000 @L["amt_twoside_aria"] 500 ₪">500 ₪</button></td>
                            <td class="addon">+95 ₪</td>
                            <td class="addon">+95 ₪</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        <ul class="check-list">
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.5"></path></svg><span>@L["info_warning_print_limit"]</span></li>
            <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.5"></path></svg><span>@L["info_lamination_explanation"]</span></li>
        </ul>
    </div>
    <section class="product-layout__side product-layout__side--narrow panel panel--raised summary-panel is-sticky" aria-labelledby="sum-h">
        <h2 id="sum-h">@L["your_order"]</h2>
        <fieldset class="opt-group">
            <legend>@L["additions"]</legend>
            <label class="check"><input type="checkbox" id="opt-lam"><span>@L["addition_lamination"]</span></label>
            <label class="check"><input type="checkbox" id="opt-round"><span>@L["addition_round_corners"]</span></label>
        </fieldset>
        <div class="price-box">
            <strong>
                @L["business_cards"] ·
                <span id="cards-spec">500</span> @L["units"] ·
                <span id="cards-sides"><span id="cards-sides-one">@L["oneside"]</span><span id="cards-sides-two">@L["twoside"]</span></span>
                <span id="lam-add"> · @L["lamination"]</span>
                <span id="round-add"> · @L["round_corners"]</span>
            </strong>
            <div class="price-box__row price-box__row--total"><span>@L["total_inc_vat"]</span><output class="price-box__total" id="cards-total" aria-live="polite">230 ₪</output></div>
            <div class="price-box__row"><span>@L["price_ready"]</span><span>@L["prep_time"]</span></div>
        </div>
        <a class="btn btn--primary btn--lg" id="calc-next" href="#" target="_blank" rel="noopener noreferrer">@L["next_load_file"]<span class="arrow" aria-hidden="true">←</span></a>
        <a class="calc__ask" href="https://wa.me/@(PHONE_NUMBER)"><svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z"></path><path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6"></path></svg>@L["question_write_us"]</a>
    </section>
</div>

<section class="section--surface">
    <div class="container info-cards">
        <div class="info-card">
            <h2>@L["file_requirements"]</h2>
            <ul class="check-list">
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_types"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_resolution"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_bleeds"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_not_ready_help"]</span></li>
            </ul>
        </div>
        <div class="info-card">
            <h2>@L["payment_pickup"]</h2>
            <ul class="check-list">
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_address"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_payment"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg><span>@L["file_min_order"]</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="after-h">
    <div class="container section__stack">
        <div class="section-head"><h2 id="after-h">@L["after_order"]</h2></div>
        <ol class="steps">
            <li class="step"><span class="step__num" aria-hidden="true">01</span><h3>@L["pick_calculate"]</h3><p class="step__text">@L["pick_calculate_description"]</p></li>
            <li class="step"><span class="step__num" aria-hidden="true">02</span><h3>@L["send_file"]</h3><p class="step__text">@L["send_file_description"]</p></li>
            <li class="step"><span class="step__num" aria-hidden="true">03</span><h3>@L["approve_sample"]</h3><p class="step__text">@L["approve_sample_description"]</p></li>
            <li class="step"><span class="step__num" aria-hidden="true">04</span><h3>@L["collect_order"]</h3><p class="step__text">@L["collect_order_description"]</p></li>
        </ol>
    </div>
</section>

@section Scripts {
    <script>
        const priceButtons = document.querySelectorAll(".price-btn");
        var prices = [];
        var lams = []
        var rounds = [];
        const lamAdd = document.getElementById("opt-lam");
        const roundAdd = document.getElementById("opt-round")
        const priceRows = document.querySelectorAll(".price-table tbody tr");
        const lamInc = document.getElementById("lam-add");
        const roundInc = document.getElementById("round-add");
        const oneside = document.getElementById("cards-sides-one");
        const twoside = document.getElementById("cards-sides-two");
        const qty = document.getElementById("cards-spec");
        const totalPrice = document.getElementById("cards-total");
        lamInc.style.display = "none";
        roundInc.style.display = "none";
        oneside.style.display = "none";

        priceButtons.forEach(x => {
            x.addEventListener('click', (e) => {
                resetButtons();
                resetRows();
                resetSidesLabel();
                e.target.ariaPressed = true;
                e.target.parentElement.parentElement.classList.add('is-selected');
                e.target.dataset.sides == "one" ? oneside.style.display = "" : twoside.style.display = "";
                qty.innerText = getSelectedQuantity();
                updateDisplayPrice();
            });

            prices.push(x.dataset.price);
            lams.push(x.parentElement.parentElement.dataset.lam);
            rounds.push(x.parentElement.parentElement.dataset.round);
        });
        [lamAdd, roundAdd].forEach(x => {
            x.addEventListener('change', (e) => {
                updateAdditionalLabels();
                calculateTotalPrice();
            })
        });

        function resetButtons() {
            priceButtons.forEach(x => x.ariaPressed = false);
        }
        function resetRows() {
            priceRows.forEach(x => x.classList.remove('is-selected'));
        }
        function resetSidesLabel() {
            oneside.style.display = "none";
            twoside.style.display = "none";
        }
        function updateAdditionalLabels() {
            lamInc.style.display = lamAdd.checked ? "" : "none";
            roundInc.style.display = roundAdd.checked ? "" : "none";
            updateDisplayPrice();
        }
        function getSelectedPriceId() {
            for (var i = 0; i < priceButtons.length; i++) {
                if (priceButtons[i].ariaPressed == "true")
                    return i;
            }
            return -1;
        }
        function getSelectedQuantity() {
            return document.getElementsByClassName('is-selected')[0].dataset.qty;
        }

        function calculateTotalPrice() {
            var itemId = getSelectedPriceId();
            var price = Number(prices[itemId]);
            if (lamAdd.checked)
                price += Number(lams[itemId]);
            if (roundAdd.checked)
                price += Number(rounds[itemId]);

            return Number(price);
        }

        function updateDisplayPrice(){
            let price = calculateTotalPrice();
            totalPrice.innerText = price + " ₪";
        }

    </script>
}