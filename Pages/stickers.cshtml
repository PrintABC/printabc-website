@page "/stickers"
@{
    ViewData["Title"] = L["meta_title"];
    ViewData["MetaDescription"] = L["meta_title"];
}
<div class="container page-head">
    <h1>@L["stickers_personal_order"]</h1>
  <p>@L["stickers_description"]</p>
</div>
<div class="container product-layout">
  <div class="product-layout__main is-sticky">
    <div class="gallery">
      <div class="gallery__main"><div class="crop"><img src="~/img/stickers-hero.jpg" alt="@L["stickers_diff_shapes_alt"]" decoding="async"><span class="crop__b" aria-hidden="true"></span></div></div>
      <div class="gallery__thumbs"><img src="~/img/stickers-sheet.jpg" alt="@L["roll_round_stickers_alt"]" loading="lazy" decoding="async"><img src="~/img/stickers-on-packaging.jpg" alt="@L["stickers_packaging_alt"]" loading="lazy" decoding="async"><img src="~/img/sticker-closeup.jpg" alt="@L["stickers_zoomed_alt"]" loading="lazy" decoding="async"></div>
    </div>
  </div>
  <form class="product-layout__side panel panel--raised calc" id="calc" aria-labelledby="calc-title" novalidate>
    <div class="calc__head"><h2 id="calc-title">@L["price_calculator"]</h2><span class="calc__demo">[demo]</span></div>
    <fieldset class="opt-group"><legend>@L["material"]</legend><div class="opt-list"><label class="pill"><input type="radio" name="material" value="paper" checked><span>@L["paper"]</span></label><label class="pill"><input type="radio" name="material" value="plastic"><span>@L["plastic"]</span></label></div><p class="field__hint">@L["paper_hint"]</p></fieldset>
    <fieldset class="opt-group"><legend>@L["shape"]</legend><div class="opt-list"><label class="pill"><input type="radio" name="shape" value="round" checked><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8"/></svg><span>@L["shape_round"]</span></label><label class="pill"><input type="radio" name="shape" value="rect"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="6" width="16" height="12" rx="1.5"/></svg><span>@L["shape_rectangle"]</span></label><label class="pill"><input type="radio" name="shape" value="free"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8c2-4 7-4 8-1s5 1 5 5-4 7-8 6-9 1-9-4 2-3 4-6z"/></svg><span>@L["shape_custom"]</span></label></div></fieldset>
    <fieldset class="opt-group"><legend>@L["cutting"]</legend><div class="opt-list"><label class="pill"><input type="radio" name="cut" value="sheet" checked><span>@L["cutting_on_roll"]</span></label><label class="pill"><input type="radio" name="cut" value="single"><span>@L["cutting_separate"]</span></label></div></fieldset>
    <fieldset class="opt-group" aria-describedby="sz-hint">
      <legend>@L["size_cm"]</legend>
      <div id="size-round" class="field field__input--size"><label class="field__hint" for="calc-d">@L["size_diameter"]</label><input class="field__input" id="calc-d" name="d" type="number" inputmode="decimal" min="1" max="31.5" step="0.1" value="5"></div>
      <div id="size-rect" class="field-row" hidden>
        <div class="field"><label class="field__hint" for="calc-w">@L["size_width"]</label><input class="field__input" id="calc-w" name="w" type="number" inputmode="decimal" min="1" max="46" step="0.1" value="5"></div>
        <div class="field"><label class="field__hint" for="calc-h">@L["size_height"]</label><input class="field__input" id="calc-h" name="h" type="number" inputmode="decimal" min="1" max="46" step="0.1" value="5"></div>
      </div>
      <p class="field__hint" id="sz-hint">@L["size_min_max"]</p>
    </fieldset>
    <div class="field">
      <label class="field__label" for="calc-qty">@L["quantity"]</label>
      <input class="field__input field__input--num" id="calc-qty" name="qty" type="number" inputmode="numeric" min="1" step="1" value="250" aria-describedby="q-hint">
      <p class="field__hint" id="q-hint">@L["quantity_price_limit"]</p>
    </div>
    <div class="alert alert--error" data-error="size" role="alert" hidden><div class="alert__row"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg><span>@L["error_min_size"]</span></div><a href="https://wa.me/972508494172">@L["special_description"]</a></div><div class="alert alert--error" data-error="big" role="alert" hidden><div class="alert__row"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg><span>@L["error_max_size"]</span></div><a href="https://wa.me/972508494172">@L["special_description"]</a></div><div class="alert alert--error" data-error="qty" role="alert" hidden><div class="alert__row"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg><span>@L["error_whole_number"]</span></div><a href="https://wa.me/972508494172">@L["special_description"]</a></div><div class="alert alert--error" data-error="min" role="alert" hidden><div class="alert__row"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg><span>@L["error_min_cost"]</span></div><a href="https://wa.me/972508494172">@L["special_description"]</a></div><div class="alert alert--error" data-error="max" role="alert" hidden><div class="alert__row"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg><span>@L["error_max_price"]</span></div><a href="https://wa.me/972508494172">@L["special_description"]</a></div>
    <div class="price-box">
      <div class="price-box__row price-box__row--total"><span>@L["total_inc_vat"]</span><output class="price-box__total" id="calc-total" aria-live="polite">— ₪</output></div>
      <div class="price-box__row"><span>@L["price_just_vat"]</span><output id="calc-vat">—</output></div>
      <div class="price-box__row"><span>@L["price_per_unit"]</span><output id="calc-unit">—</output></div>
      <div class="price-box__row"><span>@L["price_ready"]</span><span>@L["prep_time"]</span></div>
    </div>
    <a class="btn btn--primary btn--lg" id="calc-next" href="#">@L["next_load_file"]<span aria-hidden="true">←</span></a>
    <span class="btn btn--lg" id="calc-next-off" aria-disabled="true" hidden>@L["next_load_file"]</span>
    <a class="calc__ask" href="https://wa.me/972508494172"><svg class="icon icon--sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 20.5l1.3-4.3A8.6 8.6 0 1 1 7.9 19.3z"/><path d="M9 8.3c-.2 3.3 3.4 6.9 6.7 6.7l1.1-1.7-2.1-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2.1z" stroke-width="1.6"/></svg>@L["question_write_us"]</a>
  </form>
</div>
<section class="section--surface">
  <div class="container info-cards">
    <div class="info-card"><h2>@L["file_requirements"]</h2><ul class="check-list"><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_types"]</span></li><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_resolution"]</span></li><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_bleeds"]</span></li><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_contour"]</span></li><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_not_ready_help"]</span></li></ul></div>
    <div class="info-card"><h2>@L["payment_pickup"]</h2><ul class="check-list"><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_address"]</span></li><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_payment"]</span></li><li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>@L["file_min_order"]</span></li></ul></div>
  </div>
</section>
<section class="section" aria-labelledby="after-h">
  <div class="container section__stack">
    <div class="section-head"><h2 id="after-h">@L["after_order"]</h2></div>
    <ol class="steps"><li class="step"><span class="step__num" aria-hidden="true">01</span><h3>@L["pick_calculate"]</h3><p class="step__text">@L["pick_calculate_description"]</p></li><li class="step"><span class="step__num" aria-hidden="true">02</span><h3>@L["send_file"]</h3><p class="step__text">@L["send_file_description"]</p></li><li class="step"><span class="step__num" aria-hidden="true">03</span><h3>@L["approve_sample"]</h3><p class="step__text">@L["approve_sample_description"]</p></li><li class="step"><span class="step__num" aria-hidden="true">04</span><h3>@L["collect_order"]</h3><p class="step__text">@L["collect_order_description"]</p></li></ol>
  </div>
</section>
