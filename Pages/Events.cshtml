                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["file_3"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["file_4"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["file_5"]</span></li>
            </ul>
        </div>
        <div class="info-card">
            <h2>@L["pickup_payment"]</h2>
            <ul class="check-list">
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["pickup"]</span></li>
                <li><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg><span>@L["pay"]</span></li>
            </ul>
        </div>
    </div>
</section>

<section class="section" aria-labelledby="after-h">
    <div class="container section__stack">
        <div class="section-head"><h2 id="after-h">@L["after_order"]</h2></div>
        <ol class="steps">
            <li class="step"><span class="step__num" aria-hidden="true">01</span><h3>@L["after_1"]</h3></li>
            <li class="step"><span class="step__num" aria-hidden="true">02</span><h3>@L["after_2"]</h3></li>
            <li class="step"><span class="step__num" aria-hidden="true">03</span><h3>@L["after_3"]</h3></li>
            <li class="step"><span class="step__num" aria-hidden="true">04</span><h3>@L["after_4"]</h3></li>
        </ol>
    </div>
</section>

@section Scripts {
    <script>
        const messageTemplate = @Json.Serialize(L["whatsapp_template"]);
        const sizeTexts = {
            a: @Json.Serialize(L["tab_1"]),
            b: @Json.Serialize(L["tab_2"]),
            c: @Json.Serialize(L["tab_3"]),
            d: @Json.Serialize(L["tab_4"]),
        };
        const sidesTexts = {
            "1": @Json.Serialize(L["wa_sides_1"]),
            "2": @Json.Serialize(L["wa_sides_2"]),
        };

        const whatsappUrl = @Json.Serialize(WHATSAPP_URL);
        const sizeRadios = document.querySelectorAll('#ev-calc input[name="size"]');
        const paperRadios = document.querySelectorAll('#ev-calc input[name="paper"]');
        const tables = document.querySelectorAll(".ev-table");
        const priceButtons = document.querySelectorAll(".ev-table .price-btn");
        const kindName = document.getElementById("ev-kind-name");
        const summaryLine = @Json.Serialize(L["summary_line"]);
        const sumSides = { "1": @Json.Serialize(L["sum_sides_1"]), "2": @Json.Serialize(L["sum_sides_2"]) };
        const sumText = document.getElementById("ev-sum-text");
        const totalPrice = document.getElementById("ev-total");
        const whatsappButton = document.getElementById("ev-next");

        let activeTable = getTable(getCheckedSize(), getCheckedPaper());

        priceButtons.forEach(x => {
            x.addEventListener('click', (e) => {
                selectButton(e.currentTarget);
                updateDisplayPrice();
            });
        });

        sizeRadios.forEach(x => {
            x.addEventListener('change', (e) => {
                if (e.target.checked)
                    switchTable(e.target.value, getCheckedPaper());
            });
        });

        paperRadios.forEach(x => {
            x.addEventListener('change', (e) => {
                if (e.target.checked)
                    switchTable(getCheckedSize(), e.target.value);
            });
        });

        function getCheckedSize() {
            const checked = document.querySelector('#ev-calc input[name="size"]:checked');
            return checked ? checked.value : sizeRadios[0].value;
        }
        function getCheckedPaper() {
            const checked = document.querySelector('#ev-calc input[name="paper"]:checked');
            return checked ? checked.value : paperRadios[paperRadios.length - 1].value;
        }
        function getTable(size, paper) {
            return document.querySelector(`.ev-table[data-size="${size}"][data-paper="${paper}"]`);
        }
        function getSelectedButton(table) {
            return table.querySelector('.price-btn[aria-pressed="true"]');
        }

        function selectButton(btn) {
            const table = btn.closest(".ev-table");
            table.querySelectorAll(".price-btn").forEach(x => x.setAttribute("aria-pressed", "false"));
            table.querySelectorAll("tbody tr").forEach(x => x.classList.remove("is-selected"));
            btn.setAttribute("aria-pressed", "true");
            btn.closest("tr").classList.add("is-selected");
        }

        function switchTable(size, paper) {
            const prevBtn = getSelectedButton(activeTable);
            const prevQty = prevBtn ? Number(prevBtn.closest("tr").dataset.qty) : 0;
            const sides = prevBtn ? prevBtn.dataset.sides : "1";

            activeTable = getTable(size, paper);
            tables.forEach(t => t.hidden = t !== activeTable);

            const rows = Array.from(activeTable.querySelectorAll("tbody tr"));
            const row = rows.filter(r => Number(r.dataset.qty) <= prevQty).pop() || rows[0];
            selectButton(row.querySelector(`.price-btn[data-sides="${sides}"]`));

            const sizeRadio = document.querySelector(`#ev-calc input[name="size"][value="${size}"]`);
            const paperRadio = document.querySelector(`#ev-calc input[name="paper"][value="${paper}"]`);
            kindName.textContent = sizeRadio.closest("label").querySelector("span").textContent
                + " · " + paperRadio.closest("label").querySelector(".ev-paper__name").textContent;

            updateDisplayPrice();
        }

        function getSelection() {
            let btn = getSelectedButton(activeTable);
            if (!btn) {
                btn = activeTable.querySelector(".price-btn");
                selectButton(btn);
            }
            return {
                size: activeTable.dataset.size,
                paper: activeTable.dataset.paper,
                sides: btn.dataset.sides,
                qty: Number(btn.closest("tr").dataset.qty),
                price: Number(btn.dataset.price)
            };
        }

        function updateSummary(sel) {
            sumText.textContent = summaryLine.value
                .replace("{qty}", sel.qty)
                .replace("{size}", sizeTexts[sel.size].value)
                .replace("{paper}", sel.paper)
                .replace("{sides}", sumSides[sel.sides].value);
        }

        function updateWhatsappLink(sel) {
            let template = messageTemplate.value;
            const data = {
                size: sizeTexts[sel.size].value,
                paper: sel.paper,
                sides: sidesTexts[sel.sides].value,
                qty: sel.qty,
                price: sel.price,
            };
            for (const [key, value] of Object.entries(data)) {
                template = template.replaceAll(`{${key}}`, value);
            }
            whatsappButton.href = whatsappUrl + template;
        }

        function updateDisplayPrice() {
            const sel = getSelection();
            totalPrice.textContent = "" + sel.price + " ₪";
            updateSummary(sel);
            updateWhatsappLink(sel);
        }

        switchTable(getCheckedSize(), getCheckedPaper());

    </script>
}