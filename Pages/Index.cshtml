@page "/"
@model IndexModel
@{
    ViewData["Title"] = L["meta_title"];
    ViewData["MetaDescription"] = L["meta_description"];
}

<section class="container hero" aria-labelledby="hero-h">
    <div class="hero__text">
        <p class="eyebrow">
            <span class="cmyk-bars"
                  aria-hidden="true"><span></span><span></span><span></span><span></span></span>@L["since_text"]
        </p>
        <h1 id="hero-h">@L["hero_header"]</h1>
        <p class="hero__lead">@L["hero_lead"]</p>
        <div class="hero__actions">
            <a class="btn btn--primary btn--lg" href="/Stickers">@L["calc_stickers"]</a>
            <a class="link-action" href="#products">@L["all_products"] <span aria-hidden="true">←</span></a>
        </div>
        <p class="hero__proof">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="6" width="18" height="13" rx="2" />
                <circle cx="12" cy="12.5" r="3.5" />
                <path d="M8 6l1.5-2h5L16 6" />
            </svg>@L["proof"]
        </p>
        <ul class="trust">
            <li>
                <span class="stars" aria-hidden="true">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"
                         focusable="false">
                        <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4L2.8 9.5l6.4-.8z" />
                    </svg>
                </span><strong>4.9</strong> בגוגל · 13 ביקורות
            </li>
            <li>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>@L["since"]
            </li>
            <li>
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>@L["ready_in"]
            </li>
        </ul>
    </div>
    <div class="hero__media">
        <div class="crop">
            <img src="~/img/Stickers-hero.jpg" alt="@L["stickers_image_hero"]" decoding="async"><span class="crop__b" aria-hidden="true"></span>
        </div>
    </div>
</section>

<section class="section--surface" aria-label="@L["rus_heb"]">
    <ul class="container benefits">
        <li class="benefit">
            <span class="chip-icon chip-icon--magenta">
                <svg class="icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                     focusable="false">
                    <path d="M3 5h11v8H8l-3 3v-3H3z" />
                    <path d="M14 9h7v8h-2v3l-3-3h-5v-4" />
                </svg>
            </span>
            <div class="benefit__body">
                <strong class="benefit__title">@L["rus_heb"]</strong><span class="benefit__text">@L["talk_whatsapp"]</span>
            </div>
        </li>
        <li class="benefit">
            <span class="chip-icon chip-icon--cyan">
                <svg class="icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                     focusable="false">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
            </span>
            <div class="benefit__body">
                <strong class="benefit__title">@L["ready_in"]</strong><span class="benefit__text">@L["ready_depends"]</span>
            </div>
        </li>
        <li class="benefit">
            <span class="chip-icon chip-icon--yellow">
                <svg class="icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                     focusable="false">
                    <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" />
                    <circle cx="12" cy="9.5" r="2.5" />
                </svg>
            </span>
            <div class="benefit__body">
                <strong class="benefit__title">@L["collect_print"]</strong><span class="benefit__text">@L["collect_address"]</span>
            </div>
        </li>
        <li class="benefit">
            <span class="chip-icon chip-icon--grey">
                <svg class="icon" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                     focusable="false">
                    <rect x="3" y="4" width="18" height="13" rx="2" />
                    <path d="M8 21h8M12 17v4M9 9l2 2 4-4" />
                </svg>
            </span>
            <div class="benefit__body">
                <strong class="benefit__title">@L["order_site"]</strong><span class="benefit__text">@L["order_description"]</span>
            </div>
        </li>
    </ul>
</section>

<section class="section" id="products" aria-labelledby="prod-h">
    <div class="container section__stack">
        <div class="section-head">
            <h2 id="prod-h">@L["our_products"]</h2>
            <p>@L["minimum_price_incl"]</p>
        </div>
        <div class="products-grid">
            <a class="tile" href="/Stickers">
                <img src="~/img/Stickers-sheet.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
                <div class="tile__body">
                    <span class="badge badge--calc">@L["price_calculator_badge"]</span>
                    <h3>@L["stickers"]</h3>
                    <p class="tile__desc">@L["stickers_description"]</p><span class="tile__more">@L["more_details"]<span aria-hidden="true">←</span></span>
                </div>
            </a>
            <a class="tile" href="/business-cards">
                <img src="~/img/business-cards.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
                <div class="tile__body">
                    <span class="badge badge--table">@L["price_table_badge"]</span>
                    <h3>@L["business_cards"]</h3>
                    <p class="tile__desc">@L["business_cards_description"]</p><span class="tile__more">
                    @L["more_details"]<span aria-hidden="true">←</span>
                </span>
            </div>
        </a>
        <a class="tile" href="#">
            <img src="~/img/event-printing.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
            <div class="tile__body">
                <span class="badge badge--table">@L["price_table_badge"]</span>
                <h3>@L["print_events"]</h3>
                <p class="tile__desc">@L["print_events_description"]</p><span class="tile__more">@L["more_details"]<span aria-hidden="true">←</span></span>
            </div>
        </a>
        <a class="tile" href="#">
            <img src="~/img/receipt-books.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
            <div class="tile__body">
                <span class="badge badge--table">@L["price_table_badge"]</span>
                <h3>@L["pinkasim"]</h3>
                <p class="tile__desc">@L["pinkasim_description"]</p><span class="tile__more">@L["more_details"]<span aria-hidden="true">←</span></span>
            </div>
        </a>
        <a class="tile" href="#">
            <img src="~/img/envelopes.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
            <div class="tile__body">
                <span class="badge badge--table">@L["price_table_badge"]</span>
                <h3>@L["envelopes"]</h3>
                <p class="tile__desc">@L["envelopes_description"]</p><span class="tile__more">@L["more_details"]<span aria-hidden="true">←</span></span>
            </div>
        </a>
        <a class="tile" href="#">
            <img src="~/img/catalogs.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
            <div class="tile__body">
                <span class="badge badge--calc">@L["price_calculator_badge"]</span>
                <h3>@L["catalogs"]</h3>
                <p class="tile__desc">@L["catalogs_description"]</p><span class="tile__more">
                @L["more_details"]<span aria-hidden="true">←</span>
            </span>
        </div>
    </a>
    <a class="tile" href="#">
        <img src="~/img/roll-ups.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
        <div class="tile__body">
            <span class="badge badge--table">@L["price_table_badge"]</span>
            <h3>@L["rollups"]</h3>
            <p class="tile__desc">@L["rollups_description"]</p><span class="tile__more">@L["more_details"]<span aria-hidden="true">←</span></span>
        </div>
    </a>
    <a class="tile" href="#">
        <img src="~/img/banners.jpg" alt="" class="tile__img" loading="lazy" decoding="async">
        <div class="tile__body">
            <span class="badge badge--calc">@L["price_calculator_badge"]</span>
            <h3>@L["banners"]</h3>
            <p class="tile__desc">@L["banners_description"]</p><span class="tile__more">@L["more_details"]<span aria-hidden="true">←</span></span>
        </div>
    </a>
</div>
</div>
</section>

<section class="section section--dark on-dark" id="how" aria-labelledby="how-h">
    <div class="container section__stack">
        <div class="section-head">
            <h2 id="how-h">@L["how_to_order"]</h2>
        </div>
        <ol class="steps">
            <li class="step">
                <span class="step__num" aria-hidden="true">01</span>
                <h3>@L["pick_calculate"]</h3>
                <p class="step__text">@L["pick_calculate_description"]</p>
            </li>
            <li class="step">
                <span class="step__num" aria-hidden="true">02</span>
                <h3>@L["send_file"]</h3>
                <p class="step__text">@L["send_file_description"]</p>
            </li>
            <li class="step">
                <span class="step__num" aria-hidden="true">03</span>
                <h3>@L["approve_sample"]</h3>
                <p class="step__text">@L["approve_sample_description"]</p>
            </li>
            <li class="step">
                <span class="step__num" aria-hidden="true">04</span>
                <h3>@L["collect_order"]</h3>
                <p class="step__text">@L["collect_order_description"]</p>
            </li>
        </ol>
        <p class="pay-line">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="7" width="18" height="11" rx="2" />
                <path d="M3 11h18" />
            </svg>@L["pay_line"]
        </p>
    </div>
</section>

