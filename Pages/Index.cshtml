<section class="section section--surface" id="about" aria-labelledby="about-h">
    <div class="container about">
        <div class="about__media">
            <div class="about__photo-wrap">
                <figure class="about__photo crop">
                    <img src="~/img/family-archive-lowres.jpg"
                         alt="@L["about_photo_alt"]" loading="lazy" decoding="async">
                    <figcaption>@L["about_photo_caption"]</figcaption>
                    <span class="crop__b" aria-hidden="true"></span>
                </figure>
                <div class="since-sticker" aria-hidden="true">
                    <span class="since-sticker__small">@L["since_badge_small"]</span><span class="since-sticker__year">2001</span>
                </div>
            </div>
        </div>
        <div class="about__text">
            <p class="eyebrow">
                <span class="cmyk-bars"
                      aria-hidden="true"><span></span><span></span><span></span><span></span></span>@L["about_eyebrow"]
            </p>
            <h2 id="about-h">@L["about_header"]</h2>
            <p>@L["about_text_1"]</p>
            <ul class="check-list">
                <li>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg><span>@L["checklist_1"]</span>
                </li>
                <li>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg><span>@L["checklist_2"]</span>
                </li>
                <li>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg><span>@L["checklist_3"]</span>
                </li>
            </ul>
        </div>
    </div>
</section>

